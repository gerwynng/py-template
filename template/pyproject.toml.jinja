[project]
name = {{ project_name | to_json }}
version = "0.1.0"
description = {{ description | to_json }}
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = []

[build-system]
requires = ["uv_build>=0.10.6,<0.11.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = {{ package_name | to_json }}

[dependency-groups]
dev = [
    "pre-commit>=4.6",
    # The nodejs extra pins Node as a locked wheel; bare pyright downloads one at first run.
    "pyright[nodejs]>=1.1.411",
    "pytest>=8.4",
    "ruff>=0.16",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E", "F", "I", "N", "UP", "B", "SIM", "RUF", "PLE", "T10", "LOG", "PGH",
    "PT011", "PT012", "PT014", "PT015",
]

[tool.pyright]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "strict"
include = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"
